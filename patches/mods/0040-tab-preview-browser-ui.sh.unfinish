#!/bin/bash
# 在 Tab 预览卡片中叠加工具栏和系统导航栏区域。

set -e

path1="chrome/browser/tab_ui/android/java/src/org/chromium/chrome/browser/tab_ui/TabThumbnailView.java"

if grep -q 'Alice patch start 0040' "$path1"; then
    exit 100
fi

sed -i '/^import android\.graphics\.PorterDuff;$/a\
// Alice patch start 0040\
import android.graphics.Rect;\
// Alice patch end 0040' "$path1"

sed -i '/^import androidx\.core\.view\.ViewCompat;$/a\
// Alice patch start 0040\
import androidx.core.view.WindowInsetsCompat;\
// Alice patch end 0040' "$path1"

sed -i '/^import org\.chromium\.components\.tab_groups\.TabGroupColorId;$/a\
// Alice patch start 0040\
import org.chromium.ui.base.ViewUtils;\
// Alice patch end 0040' "$path1"

sed -i '/^    private final RectF mRectF;$/a\
    // Alice patch start 0040\
    private @Nullable Bitmap mAliceToolbarBitmap;\
    private @Nullable View mAliceToolbarView;\
    private final Paint mAliceToolbarPaint =\
            new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);\
    private final Rect mAliceDestinationRect = new Rect();\
    private final int[] mAliceLocation = new int[2];\
    private int mAliceToolbarWidth = -1;\
    private int mAliceToolbarHeight = -1;\
    // Alice patch end 0040' "$path1"

sed -i '/^        super\.onDraw(canvas);$/a\
        // Alice patch start 0040\
        if (!isThumbnailLoading() \&\& !isPlaceholder()) {\
            drawAliceBrowserUi(canvas);\
        }\
        // Alice patch end 0040' "$path1"

sed -i '/^    private void updateImage() {$/i\
    // Alice patch start 0040\
    private @Nullable View findAliceToolbarView(View view) {\
        if (view.getClass().getName().endsWith(".ToolbarControlContainer")) {\
            return view;\
        }\
        if (!(view instanceof android.view.ViewGroup)) return null;\
        android.view.ViewGroup group = (android.view.ViewGroup) view;\
        for (int i = 0; i < group.getChildCount(); i++) {\
            View result = findAliceToolbarView(group.getChildAt(i));\
            if (result != null) return result;\
        }\
        return null;\
    }\
\
    private @Nullable Bitmap getAliceToolbarBitmap() {\
        View root = getRootView();\
        if (mAliceToolbarView == null) {\
            mAliceToolbarView = findAliceToolbarView(root);\
        }\
        View toolbar = mAliceToolbarView;\
        if (toolbar == null || toolbar.getWidth() <= 0 || toolbar.getHeight() <= 0) {\
            return null;\
        }\
        if (mAliceToolbarBitmap != null\
                \&\& mAliceToolbarWidth == toolbar.getWidth()\
                \&\& mAliceToolbarHeight == toolbar.getHeight()) {\
            return mAliceToolbarBitmap;\
        }\
\
        Bitmap bitmap =\
                Bitmap.createBitmap(\
                        toolbar.getWidth(),\
                        toolbar.getHeight(),\
                        Bitmap.Config.ARGB_8888);\
        Canvas bitmapCanvas = new Canvas(bitmap);\
        ViewUtils.captureBitmap(toolbar, bitmapCanvas);\
        Bitmap oldBitmap = mAliceToolbarBitmap;\
        mAliceToolbarBitmap = bitmap;\
        mAliceToolbarWidth = toolbar.getWidth();\
        mAliceToolbarHeight = toolbar.getHeight();\
        if (oldBitmap != null) oldBitmap.recycle();\
        return bitmap;\
    }\
\
    private void drawAliceBrowserUi(Canvas canvas) {\
        Bitmap toolbarBitmap = getAliceToolbarBitmap();\
        View toolbar = mAliceToolbarView;\
        if (toolbarBitmap == null || toolbar == null || getWidth() <= 0) return;\
\
        int cardWidth = getWidth();\
        float scale = cardWidth / (float) toolbarBitmap.getWidth();\
        int toolbarHeight = Math.round(toolbarBitmap.getHeight() * scale);\
        View root = getRootView();\
        toolbar.getLocationInWindow(mAliceLocation);\
        boolean toolbarOnBottom = mAliceLocation[1] > root.getHeight() / 2;\
\
        WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(root);\
        int navigationHeight =\
                insets == null\
                        ? 0\
                        : insets.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom;\
        int scaledNavigationHeight = Math.round(navigationHeight * scale);\
\
        int toolbarTop =\
                toolbarOnBottom\
                        ? getHeight() - scaledNavigationHeight - toolbarHeight\
                        : 0;\
        mAliceDestinationRect.set(\
                0, toolbarTop, cardWidth, toolbarTop + toolbarHeight);\
        canvas.drawBitmap(toolbarBitmap, null, mAliceDestinationRect, mAliceToolbarPaint);\
\
        if (scaledNavigationHeight > 0) {\
            int navigationColor =\
                    toolbarBitmap.getPixel(0, Math.max(0, toolbarBitmap.getHeight() - 1));\
            mAliceToolbarPaint.setColor(navigationColor);\
            canvas.drawRect(\
                    0,\
                    getHeight() - scaledNavigationHeight,\
                    cardWidth,\
                    getHeight(),\
                    mAliceToolbarPaint);\
        }\
    }\
    // Alice patch end 0040\
' "$path1"

sed -i '$i\
    // Alice patch start 0040\
    @Override\
    protected void onDetachedFromWindow() {\
        if (mAliceToolbarBitmap != null) {\
            mAliceToolbarBitmap.recycle();\
            mAliceToolbarBitmap = null;\
        }\
        super.onDetachedFromWindow();\
    }\
    // Alice patch end 0040' "$path1"
