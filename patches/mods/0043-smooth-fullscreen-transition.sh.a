#!/bin/bash
# 平滑 HTML 全屏进入/退出：
#   1) 不再冻结退出全屏期间的 controls/WebContents 更新
#   2) 全屏及退出过渡使用真实 controlsInsets，避免叠加自定义工具栏/导航栏高度
#   3) 恢复退出全屏时 browser controls 的原生显示动画

set -e

path1="chrome/browser/fullscreen/android/java/src/org/chromium/chrome/browser/fullscreen/FullscreenManager.java"
path2="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/FullscreenHtmlApiHandlerBase.java"
path3="chrome/android/java/src/org/chromium/chrome/browser/tab/TabBrowserControlsConstraintsHelper.java"
path4="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/BrowserControlsManager.java"
path5="chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java"

if grep -q 'Alice patch start 0043' "$path1"; then
    exit 100
fi

# 恢复退出全屏时 browser controls 的原生显示动画。
sed -i 's|^\( *\)mTab, BrowserControlsState.SHOWN, false);$|\1// Alice patch start 0043\n\1mTab, BrowserControlsState.SHOWN, true);\n\1// Alice patch end 0043|' "$path2"

# 退出全屏期间仍然正常推送 constraints，不强制跳到 SHOWN。
sed -i '/^    private void updateEnabledState() {$/,/^    }$/c\
    private void updateEnabledState() {\
        if (mTab.isFrozen()) return;\
        // Alice patch start 0043\
        update(BrowserControlsState.BOTH, getConstraints() != BrowserControlsState.HIDDEN);\
        // Alice patch end 0043\
    }' "$path3"

sed -i '/^        \/\/ Alice patch start 0033$/,/^        \/\/ Alice patch end 0033$/c\
        // Alice patch start 0043\
        // Exit fullscreen constraints use the native update path.\
        // Alice patch end 0043' "$path3"

# 退出全屏时不要直接跳过 constraints 处理；保留后面的 HIDDEN 刷新。
sed -i '/^        if (FullscreenManager\.FullscreenTransitionState\.isExitingFullscreen()) {$/,/^        }$/c\
        // Alice patch start 0043\
        // Exit fullscreen constraints use the native update path.\
        // Alice patch end 0043' "$path4"

# 全屏和退出过渡期间 controls 使用 BrowserControlsManager 的真实动态值。
# 导航栏 inset 只在真正全屏时清零；退出过渡的第一帧就恢复，避免页面延迟避让。
sed -i '/^        int verticalViewportInsets =$/,/^                        + (aliceInFullscreen ? 0 : mAliceNavigationBarInset);$/c\
        // Alice patch start 0043\
        boolean aliceExitingFullscreen =\
                FullscreenManager.FullscreenTransitionState.isExitingFullscreen();\
        int aliceEffectiveControlsInset =\
                (aliceInFullscreen || aliceExitingFullscreen)\
                        ? controlsInsets\
                        : aliceTopControlsInset + aliceBottomControlsInset;\
        int aliceEffectiveNavigationBarInset =\
                aliceInFullscreen ? 0 : mAliceNavigationBarInset;\
        int verticalViewportInsets =\
                aliceEffectiveControlsInset\
                        + webContentsHeightInset\
                        + aliceEffectiveNavigationBarInset;\
        // Alice patch end 0043' "$path5"

# 退出期间也同步更新 controls/WebContents，而不是等到 controls idle 后一次性跳变。
sed -i '/^            \/\/ Alice patch start 0033$/,/^            \/\/ Alice patch end 0033$/c\
            // Alice patch start 0043\
            tryUpdateControlsAndWebContentsSizing();\
            // Alice patch end 0043' "$path5"
