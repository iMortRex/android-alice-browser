#!/bin/bash
# 全屏切换时把系统栏、browser controls 和 WebContents 视口作为一次事务提交，
# 避免进入/退出过程中页面按不同 insets 连续重排。

set -e

path1="chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java"
path2="chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java"
path3="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/BrowserControlsManager.java"
path4="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/FullscreenHtmlApiHandlerBase.java"

# 检测是否已应用
if grep -q 'Alice patch start 0042' "$path1"; then
    exit 100
fi

# 1) 记录全屏切换事务状态。切换期间 WebContents 保持旧视口，等 Android
#    controls 与系统栏都稳定后只提交一次最终尺寸。
sed -i '/^    private int mAliceNavigationBarWidth;$/a\
    // Alice patch start 0042\
    private boolean mAliceLastPersistentFullscreen;\
    private boolean mAliceFullscreenViewportTransitionPending;\
    private boolean mAliceFullscreenViewportExiting;\
    private boolean mAliceFullscreenViewportCommitted;\
    private int mAliceFullscreenViewportLockedHeight;\
    private int mAliceLastRequestedWebContentsHeight;\
    private int mAliceFullscreenViewportWaitFrames;\
    private int mAliceFullscreenViewportStableFrames;\
    private @Nullable Runnable mAliceFullscreenViewportFinishCallback;\
    private final Runnable mAliceFullscreenViewportStep =\
            this::runAliceFullscreenViewportStep;\
    // Alice patch end 0042' "$path1"

# navigationBars 的静止 inset 保留导航栏高度。事务通过节点可见性等待系统栏
# 真正完成切换，再用它一次性提交最终视口。
sed -i '/^            mAliceNavigationBarInset =$/,/^                    Math\.max(mAliceNavigationBarInset, aliceCurrentNavBarInset);$/c\
            // Alice patch start 0042\
            mAliceNavigationBarInset =\
                    Math.max(mAliceNavigationBarInset, aliceCurrentNavBarInset);\
            // Alice patch end 0042' "$path1"

sed -i '/^        boolean aliceInFullscreen =$/,/^                                \.getPersistentFullscreenMode();$/c\
        // Alice patch start 0042\
        boolean aliceInFullscreen =\
                mBrowserControlsManager != null\
                        \&\& mBrowserControlsManager\
                                .getFullscreenManager()\
                                .getPersistentFullscreenMode();\
        if (aliceInFullscreen != mAliceLastPersistentFullscreen) {\
            startAliceFullscreenViewportTransition(!aliceInFullscreen);\
        }\
        // Alice patch end 0042' "$path1"

# 0033 在退出全屏期间跳过了 controls 约束，0034 又固定了底置工具栏高度，
# 导致系统栏先回来、WebContents 仍停在旧尺寸。这里锁定旧视口，等两部分稳定。
sed -i '/^        if (isAttachedToWindow(view)) {$/i\
        // Alice patch start 0042\
        if (mAliceFullscreenViewportTransitionPending\
                \&\& !mAliceFullscreenViewportCommitted) {\
            if (mAliceFullscreenViewportLockedHeight <= 0) {\
                mAliceFullscreenViewportLockedHeight = webContentsHeight;\
            }\
            webContentsHeight = mAliceFullscreenViewportLockedHeight;\
        }\
        mAliceLastRequestedWebContentsHeight = webContentsHeight;\
        scheduleAliceFullscreenViewportStep();\
        // Alice patch end 0042\
\
' "$path1"

# 替换 0033 的退出收尾：先提交最终视口，等 RenderCoordinates 连续两帧确认
# renderer 已消费新尺寸，再恢复 Android controls、compositor 场景层和页面交互。
sed -i '/^    \/\/ Alice patch start 0033$/,/^    \/\/ Alice patch end 0033$/c\
    // Alice patch start 0042\
    public void finishAliceFullscreenExit(@Nullable Runnable onReady) {\
        mAliceFullscreenViewportFinishCallback = onReady;\
        if (!mAliceFullscreenViewportTransitionPending\
                \&\& FullscreenManager.FullscreenTransitionState\
                        .isExitingFullscreen()) {\
            startAliceFullscreenViewportTransition(/* exiting= */ true);\
        } else if (!mAliceFullscreenViewportTransitionPending) {\
            if (onReady != null) onReady.run();\
            if (mBrowserControlsManager != null) {\
                mBrowserControlsManager.showAndroidControls(/* animate= */ false);\
            }\
            return;\
        }\
        updateWebContentsSize(getCurrentTab());\
        onViewportChanged();\
        requestRender();\
    }\
\
    private void startAliceFullscreenViewportTransition(boolean exiting) {\
        removeCallbacks(mAliceFullscreenViewportStep);\
        mAliceFullscreenViewportTransitionPending = true;\
        mAliceFullscreenViewportExiting = exiting;\
        mAliceFullscreenViewportCommitted = false;\
        mAliceFullscreenViewportLockedHeight =\
                mAliceLastRequestedWebContentsHeight > 0\
                        ? mAliceLastRequestedWebContentsHeight\
                        : getViewportSize().y;\
        mAliceLastPersistentFullscreen = !exiting;\
        mAliceFullscreenViewportWaitFrames = 0;\
        mAliceFullscreenViewportStableFrames = 0;\
        scheduleAliceFullscreenViewportStep();\
    }\
\
    private void scheduleAliceFullscreenViewportStep() {\
        if (!mAliceFullscreenViewportTransitionPending) return;\
        removeCallbacks(mAliceFullscreenViewportStep);\
        postOnAnimation(mAliceFullscreenViewportStep);\
    }\
\
    private boolean isAliceFullscreenViewportSettled() {\
        BrowserControlsManager manager = mBrowserControlsManager;\
        if (manager == null) return true;\
        boolean fullscreen =\
                manager.getFullscreenManager().getPersistentFullscreenMode();\
        if (fullscreen == mAliceFullscreenViewportExiting) return false;\
        if (!BrowserControlsUtils.areBrowserControlsIdle(manager)) return false;\
        View contentView = getContentView();\
        if (contentView == null\
                || contentView.getWidth() <= 0\
                || contentView.getHeight() <= 0\
                || !contentView.isLaidOut()) {\
            return false;\
        }\
        WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(getRootView());\
        if (insets == null) return false;\
        boolean navigationBarVisible =\
                insets.isVisible(WindowInsetsCompat.Type.navigationBars());\
        return navigationBarVisible == mAliceFullscreenViewportExiting;\
    }\
\
    private void runAliceFullscreenViewportStep() {\
        if (!mAliceFullscreenViewportTransitionPending) return;\
\
        if (!mAliceFullscreenViewportCommitted) {\
            if (!isAliceFullscreenViewportSettled()\
                    \&\& mAliceFullscreenViewportWaitFrames++ < 30) {\
                scheduleAliceFullscreenViewportStep();\
                return;\
            }\
            mAliceFullscreenViewportCommitted = true;\
            mAliceFullscreenViewportWaitFrames = 0;\
            mAliceFullscreenViewportStableFrames = 0;\
            updateWebContentsSize(getCurrentTab());\
            onViewportChanged();\
            requestRender();\
            scheduleAliceFullscreenViewportStep();\
            return;\
        }\
\
        Tab tab = getCurrentTab();\
        int renderedHeight =\
                tab == null || tab.getWebContents() == null\
                        ? 0\
                        : org.chromium.content_public.browser.RenderCoordinates\
                                .fromWebContents(tab.getWebContents())\
                                .getLastFrameViewportHeightPixInt();\
        boolean rendererApplied =\
                renderedHeight <= 0\
                        || mAliceLastRequestedWebContentsHeight <= 0\
                        || Math.abs(\
                                        renderedHeight\
                                                - mAliceLastRequestedWebContentsHeight)\
                                <= 1;\
        if (rendererApplied) {\
            ++mAliceFullscreenViewportStableFrames;\
        } else {\
            mAliceFullscreenViewportStableFrames = 0;\
        }\
        if (mAliceFullscreenViewportStableFrames < 2\
                \&\& mAliceFullscreenViewportWaitFrames++ < 30) {\
            scheduleAliceFullscreenViewportStep();\
            return;\
        }\
        finishAliceFullscreenViewportTransition();\
    }\
\
    private void finishAliceFullscreenViewportTransition() {\
        boolean wasExiting = mAliceFullscreenViewportExiting;\
        Runnable onReady = mAliceFullscreenViewportFinishCallback;\
        mAliceFullscreenViewportFinishCallback = null;\
        mAliceFullscreenViewportTransitionPending = false;\
        mAliceFullscreenViewportExiting = false;\
        removeCallbacks(mAliceFullscreenViewportStep);\
\
        if (wasExiting) {\
            FullscreenManager.FullscreenTransitionState.setExitingFullscreen(false);\
            if (onReady != null) onReady.run();\
            if (mBrowserControlsManager != null) {\
                mBrowserControlsManager.showAndroidControls(/* animate= */ false);\
            }\
        }\
        onViewportChanged();\
        requestRender();\
    }\
    // Alice patch end 0042
' "$path1"

# 0033 在退出全屏时直接跳过了 BrowserControlsManager 的 SHOWN 约束，使控件
# 等到最后才定位。恢复原生约束流程；事务结束前仍由 transition 状态保持隐藏。
sed -i '/^    private void onConstraintsChanged(@BrowserControlsState int constraints) {$/,/^        if (constraints == BrowserControlsState.SHOWN) {$/c\
    private void onConstraintsChanged(@BrowserControlsState int constraints) {\
        // Alice patch start 0042\
        // Process SHOWN immediately; exit visibility is held by shouldShowAndroidControls().\
        // Alice patch end 0042\
\
        if (constraints == BrowserControlsState.SHOWN) {' "$path3"

# 退出事务完成前继续隐藏 Android controls，防止系统栏已经出现而工具栏提前
# 覆盖网页的旧布局。
sed -i '/^        if (offsetOverridden()) return true;$/i\
        // Alice patch start 0042\
        if (FullscreenManager.FullscreenTransitionState\
                .isExitingFullscreen()) return false;\
        // Alice patch end 0042\
' "$path3"

# 0033 在 tab 校验之前就标记“正在退出”。只有真正会通知观察者的退出才
# 开启事务，避免错误 tab 或重复退出把控件永久留在隐藏状态。
sed -i '/^    public void onExitFullscreen(Tab tab) {$/,/^        if (tab != mTab) return;$/c\
    public void onExitFullscreen(Tab tab) {\
        // Alice patch start 0042\
        if (tab != mTab) return;\
        // Alice patch end 0042\
' "$path4"

sed -i '/^        boolean wasInPersistentFullscreenMode = getPersistentFullscreenMode();$/a\
        // Alice patch start 0042\
        if (wasInPersistentFullscreenMode || mNotifyOnNextExit) {\
            FullscreenManager.FullscreenTransitionState.setExitingFullscreen(true);\
        }\
        // Alice patch end 0042' "$path4"

# 0033 原本在退出期间跳过 WebContents sizing；事务提交阶段需要允许 controls
# offset 与页面尺寸同步更新。
sed -i '/^            \/\/ Alice patch start 0033$/,/^            \/\/ Alice patch end 0033$/c\
            // Alice patch start 0042\
            tryUpdateControlsAndWebContentsSizing();\
            // Alice patch end 0042' "$path1"

# 退出事务结束前，compositor 工具栏层也继续压制；等 renderer 消费最终视口后
# 通过回调一次性恢复，避免 Android controls 与 compositor 层抢跑。
sed -i 's|^\(\s*\)mCompositorViewHolder\.finishAliceFullscreenExit();$|\1// Alice patch start 0042\
\1mCompositorViewHolder.finishAliceFullscreenExit(\
\1        ToolbarManager.this::updateToolbarSceneLayerSuppression);\
\1// Alice patch end 0042|' "$path2"

sed -i '/^                        || mFullscreenManager\.getPersistentFullscreenMode()$/a\
                        // Alice patch start 0042\
                        || FullscreenManager.FullscreenTransitionState\
                                .isExitingFullscreen()\
                        // Alice patch end 0042' "$path2"
