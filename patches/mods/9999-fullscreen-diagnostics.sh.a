#!/bin/bash
# 临时全屏诊断日志。只读取并打印状态，不改变控件或视口逻辑。

set -e

path1="chrome/android/java/src/org/chromium/chrome/browser/compositor/CompositorViewHolder.java"
path2="chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java"
path3="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/BrowserControlsManager.java"
path4="chrome/android/java/src/org/chromium/chrome/browser/fullscreen/FullscreenHtmlApiHandlerBase.java"
path5="chrome/browser/browser_controls/android/java/src/org/chromium/chrome/browser/browser_controls/BottomControlsStacker.java"
path6="chrome/browser/ui/android/edge_to_edge/internal/java/src/org/chromium/chrome/browser/ui/edge_to_edge/EdgeToEdgeBottomChinMediator.java"
path7="chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/ToolbarPositionController.java"

if grep -q 'Alice patch start 9999' "$path1"; then
    exit 100
fi

# 在进入全屏锁生效后记录真正传给 WebContents 的 viewport。
sed -i '/^        if (isAttachedToWindow(view)) {$/i\
        // Alice patch start 9999\
        if (mBrowserControlsManager != null) {\
            org.chromium.base.Log.i(\
                    "AliceFullscreen",\
                    "viewport view=%dx%d insets=%d result=%d top=%d bottom=%d nav=%d"\
                            + " bottomH=%d bottomMinH=%d bottomOffset=%d resize=%b"\
                            + " fullscreen=%b hiding=%b",\
                    width,\
                    height,\
                    verticalViewportInsets,\
                    webContentsHeight,\
                    aliceTopControlsInset,\
                    aliceBottomControlsInset,\
                    mAliceNavigationBarInset,\
                    mBrowserControlsManager.getBottomControlsHeight(),\
                    mBrowserControlsManager.getBottomControlsMinHeight(),\
                    mBrowserControlsManager.getBottomControlOffset(),\
                    mControlsResizeView,\
                    mBrowserControlsManager\
                            .getFullscreenManager()\
                            .getPersistentFullscreenMode(),\
                    mBrowserControlsManager.hasHidingTokens());\
        }\
        // Alice patch end 9999\
\
' "$path1"

sed -i '/^        if (isAttachedToWindow(view)) {$/i\
        // Alice patch start 9999\
        {\
            View aliceRootForLog = getRootView();\
            WindowInsetsCompat aliceInsetsForLog =\
                    ViewCompat.getRootWindowInsets(aliceRootForLog);\
            int[] aliceContentLocation = new int[2];\
            int[] aliceCompositorLocation = new int[2];\
            view.getLocationInWindow(aliceContentLocation);\
            mCompositorView.getLocationInWindow(aliceCompositorLocation);\
            int aliceContentTopMargin = -1;\
            int aliceContentBottomMargin = -1;\
            if (view.getLayoutParams() instanceof android.view.ViewGroup.MarginLayoutParams) {\
                android.view.ViewGroup.MarginLayoutParams aliceMarginParams =\
                        (android.view.ViewGroup.MarginLayoutParams) view.getLayoutParams();\
                aliceContentTopMargin = aliceMarginParams.topMargin;\
                aliceContentBottomMargin = aliceMarginParams.bottomMargin;\
            }\
            org.chromium.base.Log.i(\
                    "AliceFullscreen",\
                    "layer content=%dx%d@%d,%d transY=%.1f margin=%d/%d"\
                            + " compositor=%dx%d@%d,%d transY=%.1f"\
                            + " rendererScrollY=%d contentH=%d rendererVP=%d"\
                            + " statusVisible=%b navVisible=%b navIgnore=%d",\
                    view.getWidth(),\
                    view.getHeight(),\
                    aliceContentLocation[0],\
                    aliceContentLocation[1],\
                    view.getTranslationY(),\
                    aliceContentTopMargin,\
                    aliceContentBottomMargin,\
                    mCompositorView.getWidth(),\
                    mCompositorView.getHeight(),\
                    aliceCompositorLocation[0],\
                    aliceCompositorLocation[1],\
                    mCompositorView.getTranslationY(),\
                    org.chromium.content_public.browser.RenderCoordinates\
                            .fromWebContents(webContents)\
                            .getScrollYPixInt(),\
                    org.chromium.content_public.browser.RenderCoordinates\
                            .fromWebContents(webContents)\
                            .getContentHeightPixInt(),\
                    org.chromium.content_public.browser.RenderCoordinates\
                            .fromWebContents(webContents)\
                            .getLastFrameViewportHeightPixInt(),\
                    aliceInsetsForLog != null\
                            \&\& aliceInsetsForLog.isVisible(\
                                    WindowInsetsCompat.Type.statusBars()),\
                    aliceInsetsForLog != null\
                            \&\& aliceInsetsForLog.isVisible(\
                                    WindowInsetsCompat.Type.navigationBars()),\
                    aliceInsetsForLog == null\
                            ? -1\
                            : aliceInsetsForLog\
                                    .getInsetsIgnoringVisibility(\
                                            WindowInsetsCompat.Type.navigationBars())\
                                    .bottom);\
        }\
        // Alice patch end 9999\
\
' "$path1"

sed -i '/^    private void onAliceFullscreenModeChanged(Boolean fullscreen) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen", "supplier fullscreen=%b", Boolean.TRUE.equals(fullscreen));\
        // Alice patch end 9999' "$path1"

sed -i '/^        long delay = layoutFullscreen ? SYSTEM_UI_VIEWPORT_UPDATE_DELAY_MS : 0;$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "systemUi fullscreen=%b layoutFullscreen=%b delay=%d",\
                isInFullscreen,\
                layoutFullscreen,\
                delay);\
        // Alice patch end 9999' "$path1"

sed -i '/^    public void applyAliceFullscreenEntryViewport() {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i("AliceFullscreen", "schedule entry viewport commit");\
        // Alice patch end 9999' "$path1"

sed -i '/^    private void finishAliceEntryViewport() {$/a\
        // Alice patch start 9999\
        View aliceEntryLogView = getContentView();\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "commit entry viewport content=%dx%d compositor=%dx%d entering=%b"\
                        + " configOrientation=%d requestedOrientation=%d",\
                aliceEntryLogView == null ? -1 : aliceEntryLogView.getWidth(),\
                aliceEntryLogView == null ? -1 : aliceEntryLogView.getHeight(),\
                mCompositorView.getWidth(),\
                mCompositorView.getHeight(),\
                FullscreenManager.FullscreenTransitionState.isEnteringFullscreen(),\
                getResources().getConfiguration().orientation,\
                mActivity == null ? -99 : mActivity.getRequestedOrientation());\
        // Alice patch end 9999' "$path1"

sed -i '/^    public void applyAliceFullscreenExitViewport() {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i("AliceFullscreen", "apply exit viewport");\
        // Alice patch end 9999' "$path1"

sed -i '/^        if (!isVisibilityForced \&\& getResourceManager() != null) {$/i\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "controls offset top=%d bottom=%d newFrame=%b forced=%b",\
                topOffset,\
                bottomOffset,\
                requestNewFrame,\
                isVisibilityForced);\
        // Alice patch end 9999\
' "$path1"

sed -i '/^    public void onAndroidControlsVisibilityChanged(int visibility) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen", "android controls visibility=%d", visibility);\
        // Alice patch end 9999' "$path1"

# 记录 controls 高度变化和 Android controls 的显示入口。
sed -i '/^    private void updateBrowserControlsHeight(boolean animate) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "stacker height request total=%d min=%d animate=%b",\
                mTotalHeight,\
                mTotalMinHeight,\
                animate);\
        // Alice patch end 9999' "$path5"

sed -i '/^                aliceBottomControlsHeight, aliceBottomControlsMinHeight);$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "stacker effective height=%d min=%d raw=%d/%d chinIncluded=%b"\
                        + " lastChin=%d exiting=%b",\
                aliceBottomControlsHeight,\
                aliceBottomControlsMinHeight,\
                mTotalHeight,\
                mTotalMinHeight,\
                mLayerVisibilities.get(LayerType.BOTTOM_CHIN),\
                mAliceLastChinHeight,\
                mAliceExitingFullscreen);\
        // Alice patch end 9999' "$path5"

sed -i '/^    public void showAndroidControls(boolean animate) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "showAndroidControls animate=%b bottomH=%d bottomMinH=%d bottomOffset=%d",\
                animate,\
                getBottomControlsHeight(),\
                getBottomControlsMinHeight(),\
                getBottomControlOffset());\
        // Alice patch end 9999' "$path3"

sed -i '/^    private void onConstraintsChanged(@BrowserControlsState int constraints) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen", "constraints=%d", constraints);\
        // Alice patch end 9999' "$path3"

# 记录 chin 的计算结果，确认导航栏在哪一步进入 bottom controls。
sed -i '/^    private void updateHeightAndVisibility() {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "chin before height=%d canShow=%b yOffset=%d edge=%b fullscreen=%b keyboard=%b",\
                mModel.get(HEIGHT),\
                mModel.get(CAN_SHOW),\
                mModel.get(Y_OFFSET),\
                mIsDrawingToEdge,\
                mFullscreenManager.getPersistentFullscreenMode(),\
                mIsKeyboardVisible && mKeyboardInset > 0);\
        // Alice patch end 9999' "$path6"

sed -i '/^    void showFullscreenToolbarSnapshot() {$/i\
    // Alice patch start 9999\
    private void logAliceFullscreenSnapshotState(String event) {\
        ImageView aliceSnapshot = mSearchToolbarSnapshot;\
        android.view.ViewParent aliceParent =\
                aliceSnapshot != null ? aliceSnapshot.getParent() : null;\
        View aliceParentView =\
                aliceParent instanceof View ? (View) aliceParent : null;\
        int[] aliceLocation = new int[2];\
        if (aliceSnapshot != null) {\
            aliceSnapshot.getLocationInWindow(aliceLocation);\
        }\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "snapshot %s parent=%s id=0x%08x parentSize=%dx%d"\
                        + " attached=%b visibility=%d size=%dx%d"\
                        + " location=%d,%d z=%.1f translationY=%.1f"\
                        + " cache=%b requested=%b attempts=%d",\
                event,\
                aliceParent == null\
                        ? "null"\
                        : aliceParent.getClass().getSimpleName(),\
                aliceParentView == null ? 0 : aliceParentView.getId(),\
                aliceParentView == null ? -1 : aliceParentView.getWidth(),\
                aliceParentView == null ? -1 : aliceParentView.getHeight(),\
                aliceSnapshot != null \&\& aliceSnapshot.isAttachedToWindow(),\
                aliceSnapshot == null ? -1 : aliceSnapshot.getVisibility(),\
                aliceSnapshot == null ? -1 : aliceSnapshot.getWidth(),\
                aliceSnapshot == null ? -1 : aliceSnapshot.getHeight(),\
                aliceLocation[0],\
                aliceLocation[1],\
                aliceSnapshot == null ? -1f : aliceSnapshot.getZ(),\
                aliceSnapshot == null ? -1f : aliceSnapshot.getTranslationY(),\
                mSearchToolbarSnapshotBitmap != null,\
                mAliceFullscreenSnapshotVisible,\
                mAliceFullscreenSnapshotAttachAttempts);\
    }\
    // Alice patch end 9999\
\
' "$path7"

sed -i '/^        mAliceFullscreenSnapshotVisible = true;$/a\
        // Alice patch start 9999\
        logAliceFullscreenSnapshotState("show requested");\
        // Alice patch end 9999' "$path7"

sed -i '/^    private void ensureFullscreenToolbarSnapshotVisible() {$/a\
        // Alice patch start 9999\
        if (mAliceFullscreenSnapshotAttachAttempts % 4 == 0) {\
            logAliceFullscreenSnapshotState(\
                    "ensure attempt=" + mAliceFullscreenSnapshotAttachAttempts);\
        }\
        // Alice patch end 9999' "$path7"

sed -i '/^    void setAliceToolbarSnapshotSuppressed(boolean suppressed) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "snapshot capture suppressed=%b",\
                suppressed);\
        // Alice patch end 9999' "$path7"

sed -i '/^            aliceSnapshot.setImageBitmap(aliceBitmap);$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "captured fullscreen snapshot size=%dx%d",\
                aliceWidth,\
                aliceSnapshotHeight);\
        // Alice patch end 9999' "$path7"

sed -i '/^    void hideFullscreenToolbarSnapshot() {$/a\
        // Alice patch start 9999\
        logAliceFullscreenSnapshotState("hide requested");\
        // Alice patch end 9999' "$path7"

sed -i '/^    void releaseFullscreenToolbarSnapshot() {$/a\
        // Alice patch start 9999\
        logAliceFullscreenSnapshotState("release requested");\
        // Alice patch end 9999' "$path7"

sed -i '/^        discardAliceFullscreenToolbarSnapshot();$/a\
        // Alice patch start 9999\
        logAliceFullscreenSnapshotState("release immediate cleanup complete");\
        // Alice patch end 9999' "$path7"

# 记录 Hub 转场中快照释放计划的变化。
sed -i '0,/^                            mInTabSwitcherTransition = true;$/ { s//                            mInTabSwitcherTransition = true;\
                            \/\/ Alice patch start 9999\
                            org.chromium.base.Log.i(\
                                    "AliceFullscreen",\
                                    "Hub started showing; delayed snapshot release cancelled");\
                            \/\/ Alice patch end 9999/ }' "$path2"

sed -i '/^    private void releaseAliceFullscreenToolbarSnapshotNow() {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "release snapshot now pending=%b",\
                mAliceFullscreenSnapshotReleaseRunnable != null);\
        // Alice patch end 9999' "$path2"

sed -i '0,/^                            mLocationBarModel.updateForNonStaticLayout();$/ { s//                            mLocationBarModel.updateForNonStaticLayout();\
                            \/\/ Alice patch start 9999\
                            org.chromium.base.Log.i(\
                                    "AliceFullscreen", "Hub started hiding");\
                            \/\/ Alice patch end 9999/ }' "$path2"

sed -i '/^                            releaseAliceFullscreenToolbarSnapshotNow();$/a\
                            // Alice patch start 9999\
                            org.chromium.base.Log.i(\
                                    "AliceFullscreen",\
                                    "non-browsing layout finished; snapshot release requested");\
                            // Alice patch end 9999' "$path2"

# 记录进入/退出全屏两个上层入口。
sed -i '/^                    public void onEnterFullscreen(Tab tab, FullscreenOptions options) {$/a\
                        // Alice patch start 9999\
                        org.chromium.base.Log.i("AliceFullscreen", "ToolbarManager enter");\
                        // Alice patch end 9999' "$path2"

sed -i '/^                    public void onExitFullscreen(Tab tab) {$/a\
                        // Alice patch start 9999\
                        org.chromium.base.Log.i(\
                                "AliceFullscreen",\
                                "ToolbarManager exit containerVis=%d",\
                                mControlContainer.getView().getVisibility());\
                        // Alice patch end 9999' "$path2"

sed -i '/^    private void updateToolbarSceneLayerSuppression() {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i(\
                "AliceFullscreen",\
                "toolbar suppression current=%b containerVis=%d",\
                Boolean.TRUE.equals(mSuppressToolbarSceneLayerSupplier.get()),\
                mControlContainer.getView().getVisibility());\
        // Alice patch end 9999' "$path2"

sed -i '/^    public void onEnterFullscreen(Tab tab, FullscreenOptions options) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i("AliceFullscreen", "handler enter");\
        // Alice patch end 9999' "$path4"

sed -i '/^    public void onExitFullscreen(Tab tab) {$/a\
        // Alice patch start 9999\
        org.chromium.base.Log.i("AliceFullscreen", "handler exit");\
        // Alice patch end 9999' "$path4"
