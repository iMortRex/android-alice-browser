#!/bin/bash
# 搜索页聚焦：整个搜索框和建议列表随地址栏焦点渐隐出现、消失。

set -e

path1="chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java"
path2="chrome/browser/ui/android/omnibox/java/src/org/chromium/chrome/browser/omnibox/suggestions/SuggestionListViewBinder.java"
path3="chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/ToolbarPositionController.java"
path4="chrome/browser/ui/android/omnibox/java/src/org/chromium/chrome/browser/omnibox/suggestions/AutocompleteMediator.java"

# 检测是否已应用
if grep -q 'Alice patch start 0073' "$path1"; then
    exit 100
fi

# 搜索框快照需要 Bitmap。
sed -i '/^import android\.graphics\.Canvas;$/a\
// Alice patch start 0073\
import android.graphics.Bitmap;\
// Alice patch end 0073' "$path1"

# 工具栏增加搜索页背景透明度状态和动画。
sed -i '/^    private boolean mDropdownListScrolled;$/a\
    // Alice patch start 0073\
    private static final long ALICE_SEARCH_PAGE_FADE_DURATION_MS = 225;\
    private static final long ALICE_SEARCH_PAGE_SOLID_FADE_DURATION_MS = 96;\
    private @Nullable ValueAnimator mAliceSearchPageFadeAnimator;\
    private @Nullable ValueAnimator mAliceSearchPageSolidFadeAnimator;\
    private final Paint mAliceSearchBoxSnapshotPaint = new Paint(Paint.FILTER_BITMAP_FLAG);\
    private @Nullable Bitmap mAliceSearchBoxSnapshotBitmap;\
    private int mAliceSearchBoxSnapshotLeft;\
    private int mAliceSearchBoxSnapshotTop;\
    private float mAliceSearchPageFadeAlpha = 1f;\
    private boolean mAliceSearchPageFadeActive;\
    // Alice patch end 0073\
' "$path1"

# 地址栏焦点变化时启动搜索页背景淡入淡出。
sed -i '/^        super.onUrlFocusChange(hasFocus);$/a\
        // Alice patch start 0073\
        animateAliceSearchPageBackground(hasFocus);\
        // Alice patch end 0073\
' "$path1"

# 搜索页透明度同时作用于工具栏和整个搜索框元素。
sed -i '/^    private void updateToolbarBackground(@ColorInt int color) [{]$/i\
    // Alice patch start 0073\
    private void animateAliceSearchPageBackground(boolean hasFocus) {\
        boolean aliceWasActive = mAliceSearchPageFadeActive;\
        boolean aliceIsSearchPage = hasFocus || aliceWasActive;\
        if (!aliceIsSearchPage \&\& !aliceWasActive) {\
            if (mAliceSearchPageFadeAnimator != null) {\
                mAliceSearchPageFadeAnimator.cancel();\
                mAliceSearchPageFadeAnimator = null;\
            }\
            mAliceSearchPageFadeActive = false;\
            mAliceSearchPageFadeAlpha = 1f;\
            if (aliceWasActive\
                    \&\& ChromeFeatureList.sToolbarPhoneAnimationRefactor\
                            .isEnabled()) {\
                mToolbarBackground.setAlpha(255);\
                setBackground(mToolbarBackground);\
            }\
            invalidate();\
            return;\
        }\
\
        if (mAliceSearchPageFadeAnimator != null) {\
            mAliceSearchPageFadeAnimator.cancel();\
            mAliceSearchPageFadeAnimator = null;\
        }\
        if (mAliceSearchPageSolidFadeAnimator != null) {\
            mAliceSearchPageSolidFadeAnimator.cancel();\
            mAliceSearchPageSolidFadeAnimator = null;\
        }\
        mToolbarBackground.setAlpha(255);\
        if (hasFocus) {\
            releaseAliceSearchBoxSnapshot();\
        } else if (mAliceSearchBoxSnapshotBitmap == null\
                \&\& mAliceSearchPageGradientEnabled) {\
            captureAliceSearchBoxSnapshot();\
        }\
\
        float target = hasFocus ? 1f : 0f;\
        float start = mAliceSearchPageFadeAlpha;\
        if (hasFocus \&\& (!mAliceSearchPageFadeActive || start >= 1f)) {\
            start = 0f;\
        } else if (!hasFocus \&\& start <= 0f) {\
            start = 1f;\
        }\
\
        mAliceSearchPageFadeActive = true;\
        setAliceSearchPageFadeAlpha(start);\
        if (start == target) {\
            if (!hasFocus) finishAliceSearchPageFadeOut();\
            return;\
        }\
\
        ValueAnimator animator = ValueAnimator.ofFloat(start, target);\
        animator.setDuration(ALICE_SEARCH_PAGE_FADE_DURATION_MS);\
        animator.setInterpolator(Interpolators.FAST_OUT_SLOW_IN_INTERPOLATOR);\
        animator.addUpdateListener(\
                animation ->\
                        setAliceSearchPageFadeAlpha(\
                                (float) animation.getAnimatedValue()));\
        animator.addListener(\
                new CancelAwareAnimatorListener() {\
                    @Override\
                    public void onEnd(Animator animation) {\
                        if (mAliceSearchPageFadeAnimator != animation) return;\
                        mAliceSearchPageFadeAnimator = null;\
                        if (!hasFocus) finishAliceSearchPageFadeOut();\
                    }\
                });\
        mAliceSearchPageFadeAnimator = animator;\
        animator.start();\
    }\
\
    private void setAliceSearchPageFadeAlpha(float alpha) {\
        mAliceSearchPageFadeAlpha = MathUtils.clamp(alpha, 0f, 1f);\
        if (getToolbarHairline() != null) {\
            getToolbarHairline().setAlpha(0f);\
        }\
        invalidate();\
    }\
\
    private void captureAliceSearchBoxSnapshot() {\
        releaseAliceSearchBoxSnapshot();\
        View aliceSearchBox = mLocationBar.getContainerView();\
        int aliceWidth = aliceSearchBox.getWidth();\
        int aliceHeight = aliceSearchBox.getHeight();\
        if (aliceWidth <= 0 || aliceHeight <= 0) return;\
        Bitmap aliceBitmap =\
                Bitmap.createBitmap(\
                        aliceWidth, aliceHeight, Bitmap.Config.ARGB_8888);\
        Canvas aliceCanvas = new Canvas(aliceBitmap);\
        if (mLocationBarBackground != null) {\
            aliceCanvas.save();\
            aliceCanvas.translate(-aliceSearchBox.getLeft(), -aliceSearchBox.getTop());\
            mLocationBarBackground.draw(aliceCanvas);\
            aliceCanvas.restore();\
        }\
        ViewUtils.captureBitmap(aliceSearchBox, aliceCanvas);\
        mAliceSearchBoxSnapshotBitmap = aliceBitmap;\
        mAliceSearchBoxSnapshotLeft = aliceSearchBox.getLeft();\
        mAliceSearchBoxSnapshotTop = aliceSearchBox.getTop();\
    }\
\
    private void releaseAliceSearchBoxSnapshot() {\
        Bitmap aliceSnapshot = mAliceSearchBoxSnapshotBitmap;\
        mAliceSearchBoxSnapshotBitmap = null;\
        if (aliceSnapshot != null \&\& !aliceSnapshot.isRecycled()) {\
            aliceSnapshot.recycle();\
        }\
    }\
\
    private void drawAliceSearchBoxSnapshot(Canvas canvas) {\
        Bitmap aliceSnapshot = mAliceSearchBoxSnapshotBitmap;\
        if (mTextureCaptureMode\
                || aliceSnapshot == null\
                || aliceSnapshot.isRecycled()\
                || !mAliceSearchPageFadeActive\
                || urlHasFocus()\
                || mAliceSearchPageFadeAlpha <= 0f) {\
            return;\
        }\
        mAliceSearchBoxSnapshotPaint.setAlpha(\
                Math.round(mAliceSearchPageFadeAlpha * 255f));\
        canvas.drawBitmap(\
                aliceSnapshot,\
                mAliceSearchBoxSnapshotLeft,\
                mAliceSearchBoxSnapshotTop,\
                mAliceSearchBoxSnapshotPaint);\
    }\
\
    private void fadeInAliceSearchPageSolidBackground() {\
        if (!mAliceSearchPageGradientEnabled) {\
            mToolbarBackground.setAlpha(255);\
            return;\
        }\
        if (mAliceSearchPageSolidFadeAnimator != null) {\
            mAliceSearchPageSolidFadeAnimator.cancel();\
        }\
        mToolbarBackground.setAlpha(0);\
        if (ChromeFeatureList.sToolbarPhoneAnimationRefactor.isEnabled()) {\
            setBackground(mToolbarBackground);\
        }\
        ValueAnimator animator = ValueAnimator.ofFloat(0f, 1f);\
        animator.setDuration(ALICE_SEARCH_PAGE_SOLID_FADE_DURATION_MS);\
        animator.setInterpolator(Interpolators.FAST_OUT_SLOW_IN_INTERPOLATOR);\
        animator.addUpdateListener(\
                animation -> {\
                    mToolbarBackground.setAlpha(\
                            Math.round(\
                                    (float) animation.getAnimatedValue() * 255f));\
                    invalidate();\
                });\
        animator.addListener(\
                new CancelAwareAnimatorListener() {\
                    @Override\
                    public void onEnd(Animator animation) {\
                        if (mAliceSearchPageSolidFadeAnimator != animation) return;\
                        mAliceSearchPageSolidFadeAnimator = null;\
                        mToolbarBackground.setAlpha(255);\
                        updateBackground(false);\
                        invalidate();\
                    }\
                });\
        mAliceSearchPageSolidFadeAnimator = animator;\
        animator.start();\
    }\
\
    private void finishAliceSearchPageFadeOut() {\
        mAliceSearchPageFadeActive = false;\
        mAliceSearchPageFadeAlpha = 1f;\
        fadeInAliceSearchPageSolidBackground();\
        releaseAliceSearchBoxSnapshot();\
        if (getToolbarHairline() != null) {\
            getToolbarHairline().setAlpha(1f);\
            updateHairlineVisibility();\
        }\
        invalidate();\
    }\
    // Alice patch end 0073\
\
' "$path1"

# 关闭或销毁时取消搜索页背景动画。
sed -i '/^    private void cancelAnimations() [{]$/a\
        // Alice patch start 0073\
        if (mAliceSearchPageFadeAnimator != null) {\
            mAliceSearchPageFadeAnimator.cancel();\
            mAliceSearchPageFadeAnimator = null;\
        }\
        if (mAliceSearchPageSolidFadeAnimator != null) {\
            mAliceSearchPageSolidFadeAnimator.cancel();\
            mAliceSearchPageSolidFadeAnimator = null;\
        }\
        mToolbarBackground.setAlpha(255);\
        releaseAliceSearchBoxSnapshot();\
        // Alice patch end 0073\
' "$path1"

# 0033 快照只保留背景，避免固定住搜索框内容遮挡真实渐隐。
sed -i '/^            org\.chromium\.ui\.base\.ViewUtils\.captureBitmap(aliceCaptureView, aliceCanvas);$/c\
            // Alice patch start 0073\
            // Background-only snapshot; the real search box owns the fade.\
            // Alice patch end 0073' "$path3"

# 0039 的工具栏渐变在淡出期间继续存在。
sed -i '/^        mAliceSearchPageGradientEnabled =$/,/^                                        false);$/c\
        // Alice patch start 0073\
        mAliceSearchPageGradientEnabled =\
                ChromeSharedPreferences.getInstance()\
                        .readBoolean(ALICE_SEARCH_PAGE_GRADIENT_PREF, false)\
                        \&\& (hasFocus || mAliceSearchPageFadeActive);\
        // Alice patch end 0073' "$path1"
sed -i 's#^                && urlHasFocus()) [{]$#                // Alice patch start 0073\n                \&\& (urlHasFocus()\n                        || (mAliceSearchPageFadeActive\n                                \&\& mAliceSearchPageFadeAlpha > 0f))) {\n                // Alice patch end 0073#' "$path1"
sed -i '/^        int saveCount = canvas.saveLayer(0, 0, width, height, null);$/c\
        // Alice patch start 0073\
        int aliceFadeLayer = -1;\
        if (mAliceSearchPageFadeActive \&\& mAliceSearchPageFadeAlpha < 1f) {\
            aliceFadeLayer =\
                    canvas.saveLayerAlpha(\
                            0,\
                            0,\
                            width,\
                            height,\
                            Math.round(mAliceSearchPageFadeAlpha * 255));\
        }\
        int saveCount = canvas.saveLayer(0, 0, width, height, null);\
        // Alice patch end 0073\
' "$path1"
sed -i '/^        canvas.restoreToCount(saveCount);$/a\
        // Alice patch start 0073\
        if (aliceFadeLayer >= 0) {\
            canvas.restoreToCount(aliceFadeLayer);\
        }\
        // Alice patch end 0073\
' "$path1"
sed -i 's#^        return super.shouldDrawHairline()$#        // Alice patch start 0073\n        return super.shouldDrawHairline()\n                \&\& !(mAliceSearchPageFadeActive\n                        \&\& mAliceSearchPageFadeAlpha < 1f)#' "$path1"
sed -i '/^            if (!ChromeFeatureList\.sToolbarPhoneAnimationRefactor\.isEnabled()) {$/,/^            }$/c\
            // Alice patch start 0073\
            if (!ChromeFeatureList.sToolbarPhoneAnimationRefactor.isEnabled()) {\
                mToolbarBackground.draw(canvas);\
            } else if (mAliceSearchPageSolidFadeAnimator == null) {\
                mToolbarBackground.setAlpha(255);\
            }\
            // Alice patch end 0073' "$path1"
sed -i '/^            super\.dispatchDraw(canvas);$/a\
            // Alice patch start 0073\
            drawAliceSearchBoxSnapshot(canvas);\
            // Alice patch end 0073' "$path1"
# 建议行等容器淡出结束后再清空，避免列表内容先消失。
sed -i '/^    private static final long OMNIBOX_SUGGESTION_START_DELAY_MS = 30;$/a\
    // Alice patch start 0073\
    private static final long ALICE_SUGGESTION_LIST_CLEAR_DELAY_MS = 225;\
    // Alice patch end 0073\
' "$path4"
sed -i '/^    private @Nullable AutocompleteResult mAutocompleteResult;$/a\
    // Alice patch start 0073\
    private @Nullable Runnable mAliceSuggestionListClearRunnable;\
    // Alice patch end 0073\
' "$path4"
sed -i '/^    void endInput() [{]$/i\
    // Alice patch start 0073\
    private void cancelAliceSuggestionListClear() {\
        Runnable clearRunnable = mAliceSuggestionListClearRunnable;\
        if (clearRunnable == null) return;\
        mHandler.removeCallbacks(clearRunnable);\
        mAliceSuggestionListClearRunnable = null;\
    }\
\
    private void scheduleAliceSuggestionListClear() {\
        cancelAliceSuggestionListClear();\
        Runnable clearRunnable =\
                () -> {\
                    mAliceSuggestionListClearRunnable = null;\
                    mDropdownViewInfoListManager.clear();\
                    mAutocompleteResult = null;\
                };\
        mAliceSuggestionListClearRunnable = clearRunnable;\
        mHandler.postDelayed(clearRunnable, ALICE_SUGGESTION_LIST_CLEAR_DELAY_MS);\
    }\
    // Alice patch end 0073\
\
' "$path4"
sed -i '/^    void beginInput(FuseboxSessionState session) [{]$/a\
        // Alice patch start 0073\
        cancelAliceSuggestionListClear();\
        // Alice patch end 0073\
' "$path4"
sed -i '/^        clearSuggestions();$/c\
        // Alice patch start 0073\
        stopAutocomplete(AutocompleteStopReason.CLOBBERED);\
        dismissDeleteDialog(DialogDismissalCause.NAVIGATE_BACK_OR_TOUCH_OUTSIDE);\
        scheduleAliceSuggestionListClear();\
        // Alice patch end 0073' "$path4"
sed -i '/^        mDropdownViewInfoListManager.setSourceViewInfoList(viewInfoList);$/c\
        // Alice patch start 0073\
        if (viewInfoList.isEmpty() \&\& mSuggestionModels.size() > 0) {\
            scheduleAliceSuggestionListClear();\
            return;\
        }\
        cancelAliceSuggestionListClear();\
        mDropdownViewInfoListManager.setSourceViewInfoList(viewInfoList);\
        // Alice patch end 0073' "$path4"

# 建议列表增加整体透明度状态。
sed -i '/^    \/\*\* Holds the view components needed to renderer the suggestion list\. \*\/$/i\
    // Alice patch start 0073\
    private static final long ALICE_SEARCH_LIST_FADE_DURATION_MS = 225;\
    // Alice patch end 0073\
' "$path2"
sed -i '/^        public final OmniboxSuggestionsDropdown dropdown;$/a\
        // Alice patch start 0073\
        boolean aliceContainerVisible;\
        boolean aliceContainerHiding;\
        // Alice patch end 0073\
' "$path2"

# 建议列表整体淡入；隐藏时延迟设置 GONE，让列表和容器一起淡出。
sed -i '/^    private static void updateContainerVisibility($/,/^    }$/c\
    // Alice patch start 0073\
    private static void updateContainerVisibility(\
            PropertyModel model, SuggestionListViewHolder holder) {\
        ModelList listItems = model.get(SuggestionListProperties.SUGGESTION_MODELS);\
        boolean shouldListBeVisible =\
                model.get(SuggestionListProperties.ACTIVITY_WINDOW_FOCUSED)\
                        \&\& model.get(SuggestionListProperties.OMNIBOX_SESSION_ACTIVE)\
                        \&\& listItems.size() > 0;\
        boolean shouldContainerBeVisible =\
                model.get(SuggestionListProperties.OMNIBOX_SESSION_ACTIVE)\
                        \&\& (listItems.size() > 0\
                                || model.get(SuggestionListProperties.CONTAINER_ALWAYS_VISIBLE));\
        int listVisibility = shouldListBeVisible ? View.VISIBLE : View.GONE;\
        if (shouldContainerBeVisible) {\
            holder.dropdown.setVisibility(listVisibility);\
        }\
        updateAliceSearchListVisibility(holder, shouldContainerBeVisible);\
        updateContainerMargin(model, holder);\
    }\
\
    private static void updateAliceSearchListVisibility(\
            SuggestionListViewHolder holder, boolean shouldShow) {\
        OmniboxSuggestionsContainer container = holder.container;\
        if (shouldShow) {\
            if (holder.aliceContainerVisible) {\
                container.setVisibility(View.VISIBLE);\
                holder.dropdown.setChildAlpha(1f);\
                return;\
            }\
            container.animate().cancel();\
            boolean wasVisible = container.getVisibility() == View.VISIBLE;\
            container.setVisibility(View.VISIBLE);\
            holder.aliceContainerVisible = true;\
            holder.aliceContainerHiding = false;\
            container.setAlpha(wasVisible ? container.getAlpha() : 0f);\
            holder.dropdown.setChildAlpha(1f);\
            container.animate()\
                    .alpha(1f)\
                    .setDuration(ALICE_SEARCH_LIST_FADE_DURATION_MS)\
                    .setInterpolator(\
                            new android.view.animation.PathInterpolator(\
                                    0.4f, 0f, 0.2f, 1f))\
                    .start();\
            return;\
        }\
\
        if (holder.aliceContainerHiding) return;\
        container.animate().cancel();\
        boolean wasVisible = container.getVisibility() == View.VISIBLE;\
        if (!holder.aliceContainerVisible \&\& !wasVisible) {\
            container.setVisibility(View.GONE);\
            holder.dropdown.setVisibility(View.GONE);\
            return;\
        }\
        holder.aliceContainerVisible = false;\
        holder.aliceContainerHiding = true;\
        holder.dropdown.setChildAlpha(1f);\
        container.animate()\
                .alpha(0f)\
                .setDuration(ALICE_SEARCH_LIST_FADE_DURATION_MS)\
                .setInterpolator(\
                        new android.view.animation.PathInterpolator(\
                                0.4f, 0f, 0.2f, 1f))\
                .withEndAction(\
                        () -> {\
                            holder.aliceContainerHiding = false;\
                            if (holder.aliceContainerVisible) return;\
                            holder.container.setVisibility(View.GONE);\
                            holder.dropdown.setVisibility(View.GONE);\
                        })\
                .start();\
    }\
    // Alice patch end 0073' "$path2"
